// Deploy: Firebase Console → Storage → Rules, or `firebase deploy --only storage`.
// Client uploads use `users/{uid}/…` (see uploadUserFile.js); OCR/download use the same paths + auth.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
