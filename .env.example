# Copy to `.env` and fill in from Firebase Console → Project settings → Your apps → Web app.
# No commas, no quotes needed. Restart `npm run dev` after saving.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Storage CORS (required for OCR / downloads from the browser) ---
# This is NOT Firebase Storage rules. If alerts mention CORS, apply CORS to the bucket:
#   1. Bucket name = value of VITE_FIREBASE_STORAGE_BUCKET (Firebase Console → Storage → files URL / settings).
#   2. From this project directory (storage-cors.example.json allows all dev origins with "origin":["*"]):
#        gsutil cors set storage-cors.example.json gs://YOUR_BUCKET
#      or:
#        gcloud storage buckets update gs://YOUR_BUCKET --cors-file=storage-cors.example.json
#   3. No gsutil? Open Google Cloud Console → Cloud Storage → your bucket → open Cloud Shell (terminal icon), upload storage-cors.example.json, run the gsutil line above.
#   4. Restart is not required; hard-refresh the app (Ctrl+Shift+R).

# Tesseract.js (browser OCR) — BCP-47 language code, e.g. eng, fra, deu. Restart dev server after change.
# VITE_TESSERACT_LANG=eng
# Optional: base URL where `${lang}.traineddata` (or `.gz`) can be fetched if jsDelivr is blocked.
# VITE_TESSERACT_LANG_PATH=https://cdn.jsdelivr.net/npm/@tesseract.js-data/eng/4.0.0_best_int

# Document classifier service (Python). Expose POST `${base}/classify`.
# Example (local dev): VITE_DOC_CLASSIFIER_URL=http://127.0.0.1:8008
# Restart `npm run dev` after change.
# VITE_DOC_CLASSIFIER_URL=
